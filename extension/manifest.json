{
  "manifest_version": 3,
  "name": "Pigeon Pet",
  "version": "1.0",
  "description": "A cute pigeon walks on any website.",
  "permissions": [],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["background.js"],
      "run_at": "document_idle"
    }
  ]
}
