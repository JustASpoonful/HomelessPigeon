{
  "manifest_version": 3,
  "name": "Pigeon Everywhere (CSP‑proof)",
  "version": "1.0.0",
  "permissions": [
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": { "48": "icons/pigeon-48.png" }
}
