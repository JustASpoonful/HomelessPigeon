{
  "manifest_version": 3,
  "name": "Pigeon Auto-Updater",
  "version": "1.1",
  "description": "Injects and updates pigeonbrain.js from a button.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pigeon Updater"
  }
}
