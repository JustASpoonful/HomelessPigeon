{
  "manifest_version": 3,
  "name": "Pigeon Everywhere (CSP‑proof)",
  "version": "1.0.0",
  "description": "Injects pigeonbrain.js everywhere, regardless of CSP.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["background.js"],
    "run_at": "document_idle",
    "world": "MAIN"
  }],
  "icons": { "48": "icons/pigeon-48.png" }
}
